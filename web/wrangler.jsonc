{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bahr-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; everything else is served straight from static assets (+ public/_headers).
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Your Fly.io API, e.g. https://bahr-api.fly.dev
    "API_ORIGIN": "https://bahr-api.fly.dev"
  }
  // Secret (never in this file):  npx wrangler secret put PROXY_SECRET
}
