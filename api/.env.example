# Copy to .env for local dev:  cp .env.example .env
# In production these are Fly.io secrets:  fly secrets set KEY=value   (never commit a real .env)

PORT=3000

# PostgreSQL. Production: your Neon connection string (use the DIRECT host, not "-pooler").
# Local dev: `bun run dev` starts an embedded PostgreSQL (PGlite) and ignores this.
#            `bun run dev:pg` uses this URL instead.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_POOL_MAX=10

# 32+ random characters. Generate: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=replace-with-32-plus-random-characters

# The ONLY origin allowed by CORS and the CSRF origin check (your frontend).
ALLOWED_ORIGIN=http://localhost:5173

# Secure cookies (__Host- prefix). false only for plain-http local dev.
COOKIE_SECURE=false
SESSION_TTL_HOURS=8

# First admin, created on first boot if it doesn't exist (password: 12+ characters).
# To change it later: set new values and run `bun run admin:set` (or on Fly: fly ssh console -C "bun scripts/set-admin.ts").
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Client IP for rate limiting. On Fly: CLIENT_IP_HEADER=fly-client-ip.
# PROXY_SECRET: shared with the Cloudflare Worker so it can forward the visitor's IP.
CLIENT_IP_HEADER=
PROXY_SECRET=
