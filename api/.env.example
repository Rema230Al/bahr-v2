# Copy to .env for local dev:  cp .env.example .env
# In production set these as Fly secrets:  fly secrets set KEY=value
# Never commit a real .env.

PORT=3000
DATABASE_PATH=./data/bahr.sqlite

# The ONLY origin allowed by CORS and the CSRF origin check (your frontend).
ALLOWED_ORIGIN=http://localhost:5173

# Secure cookies (__Host- prefix). Set to false only for plain-http local dev.
COOKIE_SECURE=false
SESSION_TTL_HOURS=8

# First admin, created on boot if it doesn't exist yet (password: 12+ characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Client IP for rate limiting. On Fly set CLIENT_IP_HEADER=fly-client-ip.
# When traffic comes through the Cloudflare Worker, the Worker sends PROXY_SECRET
# and the real visitor IP; use a long random value in BOTH places (openssl rand -hex 32).
CLIENT_IP_HEADER=
PROXY_SECRET=

# Optional rate-limit tuning
# RATE_LIMIT_FORM_MAX=5
# RATE_LIMIT_FORM_WINDOW_MS=600000
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
