# Copy to .env for local dev:  cp .env.example .env
# In production these are Fly.io secrets:  fly secrets set KEY=value   (never commit a real .env)

PORT=3000

# PostgreSQL. Production: your Neon connection string (use the DIRECT host, not "-pooler").
# Local dev: `bun run dev` starts an embedded PostgreSQL (PGlite) and ignores this.
#            `bun run dev:pg` uses this URL instead.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_POOL_MAX=10

# 32+ random characters. Generate: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=replace-with-32-plus-random-characters

# The ONLY origin allowed by CORS and the CSRF origin check (your frontend).
ALLOWED_ORIGIN=http://localhost:5173

# Secure cookies (__Host- prefix). false only for plain-http local dev.
COOKIE_SECURE=false
SESSION_TTL_HOURS=8

# First admin, created on first boot if it doesn't exist (password: 12+ characters).
# To change it later: set new values and run `bun run admin:set` (or on Fly: fly ssh console -C "bun scripts/set-admin.ts").
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Calendar days for the admin date-range filter are counted in this IANA time zone.
ADMIN_TIME_ZONE=Asia/Riyadh

# Client IP for rate limiting. On Fly: CLIENT_IP_HEADER=fly-client-ip.
# PROXY_SECRET: shared with the Cloudflare Worker so it can forward the visitor's IP.
CLIENT_IP_HEADER=
PROXY_SECRET=

# "Help me shape my idea" assistant. AI_PROVIDER = workers-ai | anthropic | demo
#   demo        sample briefs built from the answers, no API calls
#   workers-ai  Cloudflare Workers AI (free tier: 10,000 neurons/day) — needs WORKERS_AI_ACCOUNT_ID + WORKERS_AI_TOKEN
#   anthropic   Claude — needs ANTHROPIC_API_KEY
# Left empty: anthropic if ANTHROPIC_API_KEY is set, otherwise demo.
# Production: keys are Fly secrets (fly secrets set …) — never commit a real key or token.
AI_PROVIDER=demo

# Cloudflare Workers AI. Account id: dashboard → Workers AI → "Use REST API".
# Token: a Cloudflare API token with ONLY "Workers AI - Read" + "Workers AI - Edit" (not your wrangler deploy token).
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_TOKEN=
# Optional. Default: @cf/google/gemma-4-26b-a4b-it (multilingual incl. Arabic). Alternative: @cf/meta/llama-3.1-8b-instruct-fp8
WORKERS_AI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Applies to every provider.
AI_TIMEOUT_MS=20000
# Per-IP briefs per window, and one daily cap shared by all visitors (cost ceiling).
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_WINDOW_MS=3600000
AI_DAILY_CAP=200
